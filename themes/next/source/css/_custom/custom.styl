// Custom styles.
code {
    color: #ff7600;
    background: #fbf7f8;
    margin: 2px;
}
// 大代码块的自定义样式
.highlight, pre {
    margin: 20px 0;
    padding: 5px;
    border-radius: 3px;
}
.highlight, code, pre {
    border: 1px solid #d6d6d6;
}

+mobile() {
    .github-corner {
        display: none;
    }
}

.at-share-btn {
    border-bottom: none;
}

.at-share-btn:hover {
    border-bottom: none;
}

.sanks-keywords {
    display: inline-block;
    background: #fff6ea;
    overflow-wrap: break-word;
    word-wrap: break-word;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: .1rem .5rem .2rem;
    margin: 0 0.2rem;
    border-radius: .2rem;
}
