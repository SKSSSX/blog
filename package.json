{
  "name": "hexo-site",
  "version": "2.0.0",
  "private": true,
  "hexo": {
    "version": "8.1.2"
  },
  "scripts": {
    "dev": "hexo server --debug -p 3111",
    "dev:draft": "hexo server --draft --debug -p 3111",
    "clean": "hexo clean",
    "build": "hexo generate",
    "deploy": "hexo deploy",
    "rebuild": "hexo clean && hexo generate",
    "publish": "hexo clean && hexo generate && hexo deploy",
    "start": "npm run dev"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-blog-encrypt": "^4.0.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-nofollow": "^2.0.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-baidu-sitemap": "^0.1.9",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-json-content": "^4.2.3",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-next-giscus": "^1.3.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-next": "^8.29.0",
    "hexo-wordcount": "^6.0.1"
  }
